<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MauiUni.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:MauiUni.Pages"
    Title="TripMate"
    FlyoutBehavior="Flyout"
    FlyoutBackgroundColor="{AppThemeBinding Light=White, Dark=#1C1C1E}">

    <FlyoutItem Title="Călătoriile mele">
        <ShellContent
            ContentTemplate="{DataTemplate pages:TripsPage}"
            Route="TripsPage"
            Title="Dashboard" />
    </FlyoutItem>

    <FlyoutItem Title="Prognoză meteo">
        <ShellContent
            ContentTemplate="{DataTemplate pages:WeatherForecastPage}"
            Route="WeatherForecastPage" />
    </FlyoutItem>

    <FlyoutItem Title="Obiective turistice">
        <ShellContent
            ContentTemplate="{DataTemplate pages:ExploreAttractionsPage}"
            Route="ExploreAttractionsPage" />
    </FlyoutItem>

    <FlyoutItem Title="Convertor valutar">
        <ShellContent
            ContentTemplate="{DataTemplate pages:CurrencyConverterPage}"
            Route="CurrencyConverterPage" />
    </FlyoutItem>

    <FlyoutItem Title="Expresii și fraze utile">
        <ShellContent
        ContentTemplate="{DataTemplate pages:TravelPhrasesPage}"
        Route="TravelPhrasesPage" />
    </FlyoutItem>

</Shell>
