<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:microcharts="clr-namespace:Microcharts.Maui;assembly=Microcharts.Maui"
             x:Class="MauiUni.Pages.BudgetAnalyticsPage"
             Title="Raport Grafic Buget"
             BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#121212}">

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="20">

            <Label Text="Analiză Buget si Cheltuieli"
                   FontSize="26"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#1C1C1E, Dark=White}"/>

            <Label x:Name="DestinatieAnalizaLabel"
                   Text="Călătorie selectată"
                   TextColor="Gray"/>

            <!-- Card Sumar Buget (Border / Frame) -->
            <Frame BackgroundColor="{AppThemeBinding Light=White, Dark=#2C2C2E}"
                   Padding="20">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Total Cheltuit" TextColor="Gray" FontSize="14"/>
                    <Label x:Name="TotalCheltuitLabel" Text="0.00 RON" FontSize="28" FontAttributes="Bold" TextColor="#2563EB"/>

                    <Label Text="Progres Buget Alocat" TextColor="Gray" FontSize="12" Margin="0,5,0,0"/>
                    <ProgressBar x:Name="BugetProgressBar" Progress="0.0" ProgressColor="#2563EB" HeightRequest="8"/>

                    <Label x:Name="ProcentBugetLabel" Text="0% din bugetul estimat consumat" FontSize="13" TextColor="Gray"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Card Grafic Circular (Microcharts DonutChart) -->
            <Frame BackgroundColor="{AppThemeBinding Light=White, Dark=#2C2C2E}"
                    Padding="18">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Distribuție pe Categorii"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#1C1C1E, Dark=White}"/>

                    <!-- Controlul ChartView pentru DonutChart -->
                    <microcharts:ChartView x:Name="BudgetChart" 
                                           HeightRequest="250" 
                                           HorizontalOptions="Fill"/>
                </VerticalStackLayout>
            </Frame>

            <Frame BackgroundColor="{AppThemeBinding Light=White, Dark=#2C2C2E}"
                    Padding="18">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Cheltuieli pe Plătitor"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#1C1C1E, Dark=White}"/>

                    <microcharts:ChartView x:Name="PayerChart" 
                                           HeightRequest="230" 
                                           HorizontalOptions="Fill"/>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>