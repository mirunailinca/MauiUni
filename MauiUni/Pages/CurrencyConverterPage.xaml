<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiUni.Pages.CurrencyConverterPage"
    Title="Convertor valutar">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label Text="Convertor valutar"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#1C1C1E, Dark=White}"/>

            <Label Text="Cursuri valutare oficiale de la Banca Națională a României."
                   FontSize="14"
                   TextColor="Gray"/>

            <Frame Padding="18"
                   CornerRadius="12"
                   BackgroundColor="{AppThemeBinding Light=#F2F2F7, Dark=#2C2C2E}"
                   BorderColor="Transparent">

                <VerticalStackLayout Spacing="12">

                    <Label Text="Suma de convertit"
                           FontAttributes="Bold"
                           FontSize="17"/>

                    <Entry x:Name="SumaEntry"
                           Placeholder="Introdu suma"
                           Keyboard="Numeric"
                           FontSize="20"/>

                    <Label Text="Moneda sursă" TextColor="Gray"/>

                    <Picker x:Name="MonedaSursaPicker"
                            Title="Selectează moneda"/>

                    <Button Text="⇅ Inversează monedele"
                            Clicked="OnInverseazaClicked"
                            BackgroundColor="#5E5CE6"
                            TextColor="White"
                            CornerRadius="10"/>

                    <Label Text="Moneda destinație" TextColor="Gray"/>

                    <Picker x:Name="MonedaDestinatiePicker"
                            Title="Selectează moneda"/>

                    <Button Text="Calculează conversia"
                            Clicked="OnConvertesteClicked"
                            BackgroundColor="#5E5CE6"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="10"
                            Padding="0,12"/>

                </VerticalStackLayout>
            </Frame>

            <Frame Padding="18"
                   CornerRadius="12"
                   BackgroundColor="{AppThemeBinding Light=White, Dark=#2C2C2E}"
                   BorderColor="Transparent"
                   HasShadow="True">

                <VerticalStackLayout Spacing="10">

                    <Label Text="Rezultat conversie"
                           FontSize="16"
                           TextColor="Gray"/>

                    <Label x:Name="RezultatLabel"
                           Text="0,00"
                           FontSize="30"
                           FontAttributes="Bold"
                           TextColor="#5E5CE6"/>

                    <Label x:Name="DetaliiLabel"
                           Text="Introdu suma și selectează monedele."
                           FontSize="14"/>

                    <Label x:Name="CursConversieLabel"
                           Text=""
                           FontSize="13"
                           TextColor="Gray"/>

                </VerticalStackLayout>
            </Frame>

            <ActivityIndicator x:Name="LoadingIndicator"
                               IsRunning="False"
                               IsVisible="False"
                               Color="#5E5CE6"/>

            <Label x:Name="DataCursLabel"
                   Text="Se încarcă datele BNR..."
                   FontSize="13"
                   TextColor="Gray"/>

            <Label x:Name="StatusLabel"
                   Text=""
                   FontSize="12"
                   TextColor="Gray"/>

            <BoxView HeightRequest="1"
                     Color="LightGray"
                     Margin="0,5"/>

            <Label Text="Evoluția cursului EUR în ultimele 10 zile"
                   FontSize="18"
                   FontAttributes="Bold"/>

            <CollectionView x:Name="IstoricView"
                            SelectionMode="None">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="0,4"
                               Padding="12"
                               CornerRadius="10"
                               BackgroundColor="{AppThemeBinding Light=#F2F2F7, Dark=#2C2C2E}"
                               BorderColor="Transparent">

                            <Label Text="{Binding .}"
                                   FontSize="14"/>

                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

            <Label Text="Sursă: Banca Națională a României. Cursurile sunt cele publicate de BNR și nu reprezintă neapărat cursul de schimb oferit de bănci sau casele de schimb."
                   FontSize="12"
                   TextColor="Gray"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>