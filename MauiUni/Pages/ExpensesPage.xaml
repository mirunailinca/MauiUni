<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiUni.Pages.ExpensesPage"
    Title="Cheltuieli">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label Text="Bugetul călătoriei"
                   FontSize="26"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#1C1C1E, Dark=White}"/>

            <Label x:Name="DestinatieLabel"
                   Text="Cheltuielile mele"
                   TextColor="Gray"/>

            <Frame BackgroundColor="{AppThemeBinding Light=White, Dark=#2C2C2E}"
                   CornerRadius="18"
                   Padding="20">

                <VerticalStackLayout Spacing="8">

                    <Label Text="Total cheltuit"
                           TextColor="Gray"
                           FontSize="14"/>

                    <Label x:Name="TotalLabel"
                           Text="0.00 RON"
                           FontSize="30"
                           FontAttributes="Bold"
                           TextColor="Gray"/>

                    <Label x:Name="BugetLabel"
                           Text="Buget disponibil: 0 RON"
                           TextColor="Gray"/>

                </VerticalStackLayout>
            </Frame>

            <Frame BackgroundColor="{AppThemeBinding Light=White, Dark=#2C2C2E}"
                   CornerRadius="18"
                   Padding="18">

                <VerticalStackLayout Spacing="12">

                    <Label Text="Adaugă cheltuială"
                           FontSize="19"
                           FontAttributes="Bold"
                           TextColor="Gray"/>

                    <Entry x:Name="SumaEntry"
                           Placeholder="Sumă"
                           Keyboard="Numeric"
                           TextColor="Gray"/>

                    <Entry x:Name="DescriereEntry"
                           Placeholder="Descriere cheltuială"
                           TextColor="Gray"/>
                    

                    <Picker x:Name="CategoriePicker"
                            Title="Selectează categoria"
                            TextColor="{AppThemeBinding Light=#4D4D4D, Dark=#DFDFDF}"
                            TitleColor="Gray"
                            BackgroundColor="{AppThemeBinding Light=#DFDFDF, Dark=#4D4D4D}">
                        <Picker.Items>
                            <x:String>Cazare</x:String>
                            <x:String>Mâncare</x:String>
                            <x:String>Transport</x:String>
                            <x:String>Activități</x:String>
                            <x:String>Altele</x:String>
                        </Picker.Items>
                    </Picker>

                    <Entry x:Name="PlatitDeEntry"
                           Placeholder="Cine a plătit?"
                           TextColor="Gray"/>

                    <Entry x:Name="ParticipantiEntry"
                           Placeholder="Participanți (Ana, Maria, Andrei)"
                           TextColor="Gray"/>

                    <Button Text="Adaugă cheltuială"
                            Clicked="OnAdaugaCheltuialaClicked"
                            BackgroundColor="#315B91"
                            TextColor="White"
                            CornerRadius="12"/>

                </VerticalStackLayout>
            </Frame>

            <Label Text="Istoric cheltuieli"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#1C1C1E, Dark=White}"/>

            <CollectionView x:Name="CheltuieliView"
                            SelectionMode="None">

                <CollectionView.EmptyView>
                    <Label Text="Nu ai înregistrat cheltuieli."
                           TextColor="Gray"
                           Padding="10"/>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BackgroundColor="{AppThemeBinding Light=White, Dark=#2C2C2E}"
                               CornerRadius="14"
                               Padding="14"
                               Margin="0,5">

                            <Grid ColumnDefinitions="*,Auto"
                                  RowDefinitions="Auto,Auto,Auto">

                                <Label Text="{Binding Descriere}"
                                       FontAttributes="Bold"
                                       FontSize="16"
                                       TextColor="Gray"/>

                                <Label Grid.Column="1"
                                       Text="{Binding Suma, StringFormat='{0:N2} RON'}"
                                       FontAttributes="Bold"
                                       TextColor="#5E5CE6"/>

                                <Label Grid.Row="1"
                                       Text="{Binding Categorie}"
                                       FontSize="13"
                                       TextColor="Gray"/>

                                <Label Grid.Row="2"
                                       Text="{Binding PlatitDe, StringFormat='Plătit de: {0}'}"
                                       FontSize="12"
                                       TextColor="Gray"/>

                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

            <Button Text="Calculează împărțirea cheltuielilor"
                    Clicked="OnCalculeazaClicked"
                    BackgroundColor="#24344D"
                    TextColor="White"
                    CornerRadius="12"/>

            <Frame BackgroundColor="{AppThemeBinding Light=White, Dark=#2C2C2E}"
                   CornerRadius="18"
                   Padding="18">

                <VerticalStackLayout Spacing="10">

                    <Label Text="Situația participanților"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#1C1C1E, Dark=White}"/>

                    <Label x:Name="ImpartireLabel"
                           Text="Adaugă cheltuieli pentru a calcula împărțirea."
                           TextColor="Gray"/>

                </VerticalStackLayout>
            </Frame>

            <Button Text="Vizualizează raportul bugetului și al cheltuielilor"
                    Clicked="OnDeschideGraficClicked"
                    BackgroundColor="#24344D"
                    TextColor="White"
                    CornerRadius="12"
                    Margin="0,10,0,0"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
