<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiUni.Pages.TravelDocumentsPage"
    Title="Documente transport"
    BackgroundColor="#F5F7FA">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label Text="Bilete și documente"
                   FontSize="26"
                   FontAttributes="Bold"
                   TextColor="#24344D"/>

            <Label x:Name="DestinatieLabel"
                   Text="Documentele călătoriei"
                   TextColor="Gray"/>

            <Frame BackgroundColor="White"
                   CornerRadius="18"
                   Padding="18">

                <VerticalStackLayout Spacing="13">

                    <Label Text="Adaugă un document"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#24344D"/>

                    <Label Text="Tip transport" TextColor="Gray"/>

                    <Picker x:Name="TransportPicker"
                            Title="Selectează transportul"
                            TextColor="#24344D">
                        <Picker.Items>
                            <x:String>Avion</x:String>
                            <x:String>Tren</x:String>
                            <x:String>Autobuz</x:String>
                        </Picker.Items>
                    </Picker>

                    <Label Text="Cod rezervare / Număr zbor"
                           TextColor="Gray"/>

                    <Entry x:Name="CodEntry"
                           Placeholder="Ex: RO12345"
                           TextColor="#24344D"/>

                    <Label Text="Loc / Terminal"
                           TextColor="Gray"/>

                    <Entry x:Name="LocatieEntry"
                           Placeholder="Ex: Terminal 2, Locul 15"
                           TextColor="#24344D"/>

                    <Button Text="Atașează bilet"
                            Clicked="OnAtaseazaClicked"
                            BackgroundColor="#E8EFF8"
                            TextColor="#315B91"/>

                    <Label x:Name="FisierLabel"
                           Text="Nu ai selectat niciun fișier."
                           FontSize="12"
                           TextColor="Gray"/>

                    <Button Text="Salvează documentul"
                            Clicked="OnSalveazaClicked"
                            BackgroundColor="#315B91"
                            TextColor="White"
                            CornerRadius="12"/>

                </VerticalStackLayout>
            </Frame>

            <Label Text="Documentele mele"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="#24344D"/>

            <CollectionView x:Name="DocumenteView"
                SelectionMode="None">

                <CollectionView.EmptyView>
                    <Label Text="Nu există documente salvate."
               TextColor="Gray"
               Padding="10"/>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BackgroundColor="{AppThemeBinding Light=White, Dark=#2C2C2E}"
                   CornerRadius="12"
                   Padding="15"
                   Margin="0,5"
                   BorderColor="Transparent"
                   HasShadow="True">

                            <VerticalStackLayout Spacing="7">

                                <Label Text="{Binding TipTransport}"
                           FontAttributes="Bold"
                           FontSize="17"
                           TextColor="#5E5CE6"/>

                                <Label Text="{Binding CodRezervare,
                                          StringFormat='Cod rezervare: {0}'}"
                           FontSize="14"/>

                                <Label Text="{Binding Locatie}"
                           FontSize="13"
                           TextColor="Gray"/>

                                <Label Text="{Binding NumeFisier}"
                           FontSize="12"
                           TextColor="Gray"/>

                                <Button Text="Deschide documentul"
                            Clicked="OnDeschideDocumentClicked"
                            BackgroundColor="#5E5CE6"
                            TextColor="White"
                            CornerRadius="10"/>

                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
