<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiUni.Pages.TravelPhrasesPage"
             Title="Expresii și fraze utile">

    <Grid RowDefinitions="Auto, Auto, Auto, Auto, *" Padding="16" RowSpacing="12">
        <HorizontalStackLayout Grid.Row="0" Spacing="10" VerticalOptions="Center">
            <Image Source="dotnet_bot.png" WidthRequest="32" HeightRequest="32" Aspect="AspectFit"/>
            <Label Text="Ghid rapid de conversație" FontSize="20" FontAttributes="Bold" 
                   TextColor="{AppThemeBinding Light=#1E3A8A, Dark=#60A5FA}" VerticalOptions="Center"/>
        </HorizontalStackLayout>

        <Picker Grid.Row="1" x:Name="LimbaPicker"
                Title="Selectează limba țintă"
                SelectedIndexChanged="OnFiltruSchimbat"
                BackgroundColor="{AppThemeBinding Light=White, Dark=#2C2C2E}"
                TextColor="{AppThemeBinding Light=#1C1C1E, Dark=White}">
            <Picker.Items>
                <x:String>Engleză</x:String>
                <x:String>Franceză</x:String>
                <x:String>Spaniolă</x:String>
                <x:String>Italiană</x:String>
                <x:String>Germană</x:String>
            </Picker.Items>
        </Picker>

        <Picker Grid.Row="2" x:Name="CategoriePicker"
                Title="Selectează categoria"
                SelectedIndexChanged="OnFiltruSchimbat"
                BackgroundColor="{AppThemeBinding Light=White, Dark=#2C2C2E}"
                TextColor="{AppThemeBinding Light=#1C1C1E, Dark=White}"/>

        <SearchBar Grid.Row="3" x:Name="BaraCautareFraze"
                   Placeholder="Caută o expresie..."
                   TextChanged="OnCautareTextChanged" />

        <CollectionView Grid.Row="4" x:Name="ListaFrazeView">
            <CollectionView.EmptyView>
                <Label Text="Nu s-au găsit expresii pentru căutarea introdusă."
                       TextColor="Gray" HorizontalOptions="Center" VerticalOptions="Center"/>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <VerticalStackLayout>
                        <Frame Margin="0,4" Padding="12"
                                BackgroundColor="{AppThemeBinding Light=White, Dark=#2C2C2E}">
                            <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto, Auto" RowSpacing="4">

                                <Label Text="{Binding Categorie}" FontSize="12" TextColor="Gray" FontAttributes="Italic"/>
                                <Label Grid.Row="1" Text="{Binding FrazaOriginala}" FontSize="14" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#1C1C1E, Dark=#DFDFDF}"/>
                                <Label Grid.Row="2" Text="{Binding TraducereCurenta}" FontSize="15" 
                                       TextColor="#4573EB" FontAttributes="Bold"/>
                                <Button Grid.Column="1" Grid.RowSpan="3"
                                        Text="📋 Copiază"
                                        Clicked="OnCopiazaFrazaClicked"
                                        BackgroundColor="#E0E7FF"
                                        TextColor="#1E40AF"
                                        CornerRadius="8"
                                        FontSize="12"
                                        Padding="10,0"/>
                            </Grid>
                        </Frame>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>