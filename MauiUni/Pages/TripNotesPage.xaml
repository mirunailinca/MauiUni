<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiUni.Pages.TripNotesPage"
             Title="Jurnal &amp; Amintiri">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                <Button Grid.Column="0" Text="Planifică itinerariul"
                        Clicked="OnItinerariuClicked"
                        CornerRadius="10"
                        BackgroundColor="#FF9F0A"
                        TextColor="White"
                        FontAttributes="Bold"
                        Padding="0,12" />

                <Button Grid.Column="1" Text="Checklist bagaj"
                        Clicked="OnBagajClicked"
                        CornerRadius="10"
                        BackgroundColor="#32D74B"
                        TextColor="White"
                        FontAttributes="Bold"
                        Padding="0,12" />
            </Grid>

            <!-- ACEASTA ESTE LISTA CARE ÎȚI LIPSEA (ListaNotiteView) -->
            <Label Text="Amintiri Salvate:" FontAttributes="Bold" FontSize="18" TextColor="{AppThemeBinding Light=#1C1C1E, Dark=White}" />

            <CollectionView x:Name="ListaNotiteView">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="0,5" Padding="15" CornerRadius="12" BackgroundColor="{AppThemeBinding Light=#F2F2F7, Dark=#2C2C2E}" BorderColor="Transparent">
                            <VerticalStackLayout Spacing="5">
                                <HorizontalStackLayout Spacing="10">
                                    <Label Text="⭐" IsVisible="{Binding EsteFavorita}" />
                                    <Label Text="{Binding Subiect}" FontAttributes="Bold" FontSize="16" />
                                </HorizontalStackLayout>
                                <Label Text="{Binding Text}" FontSize="14" />
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- O linie de despărțire între lista veche și formularul nou -->
            <BoxView HeightRequest="1" Color="LightGray" Margin="0,10" />

            <!-- Formular Adăugare Notiță Nouă -->
            <Label Text="Adaugă o Amintire Nouă:" FontAttributes="Bold" FontSize="18" />

            <Frame Padding="0" CornerRadius="10" BackgroundColor="{AppThemeBinding Light=#F2F2F7, Dark=#1C1C1E}" BorderColor="Transparent">
                <Entry x:Name="SubiectEntry" Placeholder="Subiect (ex. Restaurant bun...)" FontSize="16" Margin="15,5" BackgroundColor="Transparent" />
            </Frame>

            <Frame Padding="0" CornerRadius="10" BackgroundColor="{AppThemeBinding Light=#F2F2F7, Dark=#1C1C1E}" BorderColor="Transparent">
                <Editor x:Name="NotitaEditor" Placeholder="Scrie aici impresiile tale..." HeightRequest="100" FontSize="15" Margin="15,10" BackgroundColor="Transparent" MaxLength="500" TextChanged="OnEditorTextChanged" />
            </Frame>
            <Label x:Name="ContorLabel" Text="0/500 caractere" FontSize="12" TextColor="Gray" HorizontalOptions="End" Margin="0,-15,0,0" />

            <Frame Padding="15" CornerRadius="12" BackgroundColor="{AppThemeBinding Light=White, Dark=#2C2C2E}" BorderColor="Transparent" HasShadow="True">
                <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <Label Text="⭐" FontSize="20" VerticalOptions="Center" />
                        <Label Text="Marchează ca importantă" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Switch Grid.Column="1" x:Name="FavoritSwitch" OnColor="#FFD60A" />
                </Grid>
            </Frame>

            <Button Text="💾 Salvează Notița" Clicked="OnSalveazaNotitaClicked" CornerRadius="10" BackgroundColor="#5E5CE6" TextColor="White" FontAttributes="Bold" Padding="0,12" Margin="0,10,0,20" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>